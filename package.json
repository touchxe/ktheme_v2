{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{PROJECT_DESCRIPTION}}",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",

    "wt:add": "node scripts/wt-add.mjs",
    "wt:list": "git worktree list",
    "wt:remove": "node scripts/wt-remove.mjs",
    "wt:launch": "node scripts/wt-launch-parallel.mjs",
    "wt:sync": "node scripts/wt-sync.mjs",
    "wt:ports": "node scripts/wt-ports.mjs",

    "bmad:help": "echo 'Run: @bmad-master in Cursor, or .agent/skills/using-superpowers in Antigravity'",

    "design:review": "echo 'Run: @gstack-design-review in Cursor with target URL'",
    "design:shotgun": "echo 'Run: @gstack-design-shotgun in Cursor (requires OPENAI_API_KEY)'",

    "sp:init-dirs": "mkdir -p docs/superpowers/specs docs/superpowers/plans docs/plans",

    "prepare": "[ -d .git ] && npm run sp:init-dirs || true"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
