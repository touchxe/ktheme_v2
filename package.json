{
  "name": "k-theme",
  "version": "1.0.0",
  "private": true,
  "description": "KTheme Modu commercial WordPress block theme with optional industry presets",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:extensions": "node scripts/validate-extension-registry.mjs docs/architecture/extension-registry.json docs/architecture/extension.example.json wp-content/plugins/ktheme-preset-church/extension.json tests/fixtures/ktheme-preset-education/extension.json",
    "validate:theme-library": "node scripts/validate-theme-library.mjs",
		"lint:php": "node scripts/lint-php.mjs",
    "audit:release": "node scripts/audit-release-readiness.mjs",
    "package:release:dry-run": "node scripts/build-release-packages.mjs --dry-run",
    "package:release": "node scripts/build-release-packages.mjs",
    "deploy:theme": "node scripts/deploy-theme.mjs",
    "activate:theme": "node scripts/activate-theme.mjs",
    "sync:pages": "node scripts/sync-wp-pages.mjs",
    "sync:worship": "node scripts/sync-worship-page.mjs",
    "sync:design-library": "node scripts/sync-design-library-page.mjs",
    "seed:dummy": "node scripts/seed-dummy-content.mjs",
    "cleanup:duplicate-pages": "node scripts/cleanup-duplicate-pages.mjs",

    "wt:add": "node scripts/wt-add.mjs",
    "wt:list": "git worktree list",
    "wt:remove": "node scripts/wt-remove.mjs",
    "wt:launch": "node scripts/wt-launch-parallel.mjs",
    "wt:sync": "node scripts/wt-sync.mjs",
    "wt:ports": "node scripts/wt-ports.mjs",

    "bmad:help": "echo 'Run: @bmad-master in Cursor, or .agent/skills/using-superpowers in Antigravity'",

    "design:review": "echo 'Run: @gstack-design-review in Cursor with target URL'",
    "design:shotgun": "echo 'Run: @gstack-design-shotgun in Cursor (requires OPENAI_API_KEY)'",

    "sp:init-dirs": "node -e \"const fs=require('fs');['docs/superpowers/specs','docs/superpowers/plans','docs/plans'].forEach(d=>fs.mkdirSync(d,{recursive:true}))\""
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
