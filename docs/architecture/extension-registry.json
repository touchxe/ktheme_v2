{
  "$schema": "./extension-registry.schema.json",
  "version": 1,
  "product": {
    "root": "modutheme",
    "themeSlug": "modu-theme",
    "enginePluginSlug": "modutheme-engine"
  },
  "namespaces": {
    "phpFunctionPrefix": "modutheme_",
    "phpClassPrefix": "ModuTheme_",
    "phpNamespace": "ModuTheme\\",
    "blockNamespace": "modutheme-engine",
    "patternNamespace": "modutheme",
    "legacyCssPrefix": "modu-",
    "cssPrefix": "modutheme-",
    "assetHandlePrefix": "modutheme-",
    "optionPrefix": "modutheme_",
    "hookPrefix": "modutheme/",
    "restNamespace": "modutheme/v1",
    "jsPackageScope": "@modutheme/"
  },
  "extensionTypes": [
    "pattern",
    "block-style",
    "block-variation",
    "block",
    "widget",
    "component",
    "skin",
    "preset",
    "integration"
  ],
  "patternScopes": [
    "page",
    "section",
    "query",
    "integration",
    "header",
    "footer"
  ],
  "genericContentModels": {
    "postTypes": [
      "modutheme_media",
      "modutheme_event",
      "modutheme_resource",
      "modutheme_profile"
    ],
    "taxonomies": [
      "modutheme_media_type",
      "modutheme_collection",
      "modutheme_topic",
      "modutheme_audience",
      "modutheme_location"
    ]
  },
  "forbiddenPersistentTerms": [
    "church",
    "sermon",
    "worship",
    "ministry",
    "style1",
    "style2",
    "style3",
    "final",
    "temp"
  ],
  "designPolicy": {
    "preserveCurrentDesign": true,
    "sourceOfTruth": "docs/DESIGN.md",
    "tokenSource": "wp-content/themes/modu-theme/theme.json"
  },
  "compatibilityPolicy": {
    "existingCustomerSites": false,
    "legacyMigrationRequired": false,
    "removeLegacyShortcodesBeforeRelease": true,
    "renameVersionedPatternNamespaceBeforeRelease": true
  }
}
