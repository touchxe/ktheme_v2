{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ktheme.example/schemas/extension.schema.json",
  "title": "KTheme Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "title",
    "description",
    "entry",
    "dependencies",
    "supports",
    "status"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^(ktheme|ktheme-engine|ktheme-[a-z0-9-]+)/[a-z][a-z0-9-]+$"
    },
    "type": {
      "enum": [
        "pattern",
        "block-style",
        "block-variation",
        "block",
        "widget",
        "component",
        "skin",
        "preset",
        "integration"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "supports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "editor",
          "frontend",
          "responsive",
          "accessibility",
          "empty-state",
          "loading-state",
          "error-state",
          "legacy-widgets"
        ]
      }
    },
    "status": { "enum": ["experimental", "stable", "deprecated"] }
  }
}
